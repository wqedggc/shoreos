# Default binds to this Mac only. Set an explicit address only when deploying behind auth/TLS.
SHOREOS_HTTP_ADDR=127.0.0.1:8090

SHOREOS_ADMIN_USERNAME=shore
SHOREOS_ADMIN_PASSWORD=
SHOREOS_ADMIN_DISPLAY_NAME=Shore
# Only for first local initialization on 127.0.0.1. Disabled by default.
SHOREOS_ENABLE_LOCAL_BOOTSTRAP=false
# Public username/password registration. Disable for a private single-user deployment.
SHOREOS_ENABLE_REGISTRATION=true
# Production default: one-week sessions and login throttle; override only deliberately.
SHOREOS_SESSION_TTL=168h
SHOREOS_LOGIN_MAX_FAILURES=8
SHOREOS_LOGIN_FAILURE_WINDOW=15m

SHOREOS_MYSQL_USER=root
SHOREOS_MYSQL_PASSWORD=
SHOREOS_MYSQL_HOST=127.0.0.1
SHOREOS_MYSQL_PORT=3306
SHOREOS_MYSQL_DATABASE=shoreos
# Local macOS may need /tmp/mysql.sock. Leave empty on Tencent CVM when TCP works.
SHOREOS_MYSQL_SOCKET=
# Preferred for local development: point to an existing MySQL client defaults file.
# Explicit SHOREOS_MYSQL_* values take precedence and the file is never logged.
# SHOREOS_MYSQL_DEFAULTS_FILE=/absolute/path/to/shoreos_agent.cnf

# Local-only ledger import storage. Keep this directory private and out of Git.
SHOREOS_LEDGER_STORAGE_DIR=storage/ledger
# Install tools/requirements-ledger.txt in this interpreter before enabling PDF/XLSX imports.
SHOREOS_LEDGER_PYTHON_BIN=.venv-ledger/bin/python
SHOREOS_LEDGER_WORKER_PATH=tools/ledger_importer.py

# WeChat Mini Program identity binding. Keep both empty until the Mini Program is configured.
SHOREOS_WECHAT_APPID=
SHOREOS_WECHAT_SECRET=
SHOREOS_IDENTITY_BIND_TTL=10m
